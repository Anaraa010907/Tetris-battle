<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- online accounts, ranked matchmaking and live matches (Supabase); ads and purchases -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The ads SDK adds ACCESS_NETWORK_STATE, READ_BASIC_PHONE_STATE and com.google.android.gms.permission.AD_ID
         (advertising ID) at build time, and Play Billing adds com.android.vending.BILLING. Declare them in Play
         Console (Advertising ID, Data safety): docs/MONETIZATION.md. -->

    <!--
      allowBackup: Android's own backup (to the player's Google account) keeps offline progress and the
        guest account when the player moves to a new phone. Nothing is sent to us by it.
      appCategory="game": marks the app as a game; on Android 16 large screens games keep their portrait lock.
      enableOnBackInvokedCallback: Android 13+ sends Back to MainActivity's OnBackInvokedCallback
        (the default from Android 16 when targeting API 36; set here so Android 13-15 behave the same).
    -->
    <application
        android:label="Khan Blocks"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.KhanBlocks">
        <!-- configChanges: rotating, folding, resizing or switching dark mode must not reload the game mid-match -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AdMob app ID (the UMP consent SDK reads it here). Google's test ID unless the release build got the real
             one from the ADMOB_APP_ID secret (app/build.gradle). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>
</manifest>
