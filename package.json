{
  "name": "khan-blocks",
  "version": "1.3.0",
  "private": true,
  "description": "Khan Blocks iOS app: Capacitor wrapper around the single-file game (index.html). See docs/IOS.md.",
  "scripts": {
    "prepare-web": "node tools/prepare-web.mjs",
    "ios:add": "node tools/prepare-web.mjs && cap add ios",
    "ios:sync": "node tools/prepare-web.mjs && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
